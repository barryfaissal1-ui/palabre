# Copie ce fichier en ".env" et remplis les valeurs.
# Ne mets JAMAIS le fichier .env sur GitHub (il est ignoré par .gitignore).

NODE_ENV=development
PORT=3000
# En production : l'adresse du site en https, sans « / » à la fin (obligatoire, sinon le serveur refuse de démarrer).
URL_PUBLIQUE=http://localhost:3000

# Base PostgreSQL (en production : l'adresse fournie par Systalink)
DATABASE_URL=postgres://palabre:palabre@localhost:5432/palabre
DATABASE_SSL=false

# Clé secrète des sessions : une longue chaîne aléatoire, différente en production.
# Pour en générer une : node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# En production, le serveur refuse de démarrer si elle est absente, fait moins de 32 caractères ou vaut « a-remplacer ».
JWT_SECRET=a-remplacer

# Envoi d'emails (E-mail Pro Systalink). Laisse vide en local : les emails s'affichent dans la console.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Palabre <no-reply@palabre.dev>

# Appels audio et vidéo (facultatif). Sans TURN, les appels marchent là où le réseau le permet.
# TURN_URL : l'adresse de notre serveur coturn (plusieurs séparées par des virgules) ; TURN_SECRET : le secret
# partagé avec lui (« static-auth-secret »). Voir docs/APPELS-TURN.md.
# TURN_URL=turns:turn.palabre.dev:443?transport=tcp,turn:turn.palabre.dev:3478
TURN_URL=
TURN_SECRET=

# Notifications push (facultatif). Laisse vide : le site marche normalement, sans push.
# Pour fabriquer les deux clés : npm run cles-push   (une seule fois ; la clé privée ne va jamais sur GitHub)
VAPID_PUBLIQUE=
VAPID_PRIVEE=
VAPID_SUJET=mailto:contact@palabre.dev

# Lieu approximatif des connexions (facultatif). Si l'hébergeur ou le proxy ajoute le pays et la ville du visiteur
# dans un en-tête, écrire ici le nom de ces en-têtes. Sans eux, aucun lieu n'est affiché.
# ENTETE_PAYS=
# ENTETE_VILLE=
